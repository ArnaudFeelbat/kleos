{
  "name": "@kleos/desktop",
  "productName": "Kleos",
  "version": "0.7.2",
  "license": "MIT",
  "private": true,
  "description": "A personal Postgres client for the Mac",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@kleos/server": "workspace:*",
    "@kleos/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "ssh2": "^1.17.0"
  }
}
